    {
      "description": "Index of the angelic rank reached with this much light (Content.ranks).",
      "fullName": "Rank index",
      "functionType": "Expression",
      "group": "Progress",
      "name": "RankIndex",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const ranks = runtimeScene.getGame().getVariables().get('Content').getChild('ranks').getAllChildrenArray();",
            "const light = eventsFunctionContext.getArgument(\"Light\");",
            "let index = 0;",
            "ranks.forEach((r, i) => { if (light >= r.getChild('light').getAsNumber()) index = i; });",
            "eventsFunctionContext.returnValue = index;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "expressionType": {
