    {
      "description": "Light needed for the next rank (0 at the last one).",
      "fullName": "Light of the next rank",
      "functionType": "Expression",
      "group": "Progress",
      "name": "NextRankLight",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const ranks = runtimeScene.getGame().getVariables().get('Content').getChild('ranks').getAllChildrenArray();",
            "const light = eventsFunctionContext.getArgument(\"Light\");",
            "const next = ranks.map(r => r.getChild('light').getAsNumber()).find(l => l > light);",
            "eventsFunctionContext.returnValue = next === undefined ? 0 : next;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
