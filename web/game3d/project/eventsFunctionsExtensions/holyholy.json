    {
      "description": "The chapter can be played: the first one, or the chapter that opens it is done.",
      "fullName": "Chapter is open",
      "functionType": "Condition",
      "group": "Progress",
      "name": "IsChapterOpen",
      "sentence": "Chapter _PARAM1_ is open",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const game = runtimeScene.getGame();",
            "const chapters = game.getVariables().get('Content').getChild('chapters');",
            "const index = Math.round(eventsFunctionContext.getArgument(\"Index\"));",
            "if (index < 0 || index >= chapters.getChildrenCount()) { eventsFunctionContext.returnValue = false; return; }",
            "const by = chapters.getChildAt(index).getChild('unlockedBy').getAsString();",
            "const done = game.getVariables().get('Save').getChild('done');",
            "eventsFunctionContext.returnValue = by === '' || (done.hasChild(by) && done.getChild(by).getAsBoolean());",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Chapter index",
          "name": "Index",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "The chapter has been completed at least once.",
      "fullName": "Chapter is done",
      "functionType": "Condition",
      "group": "Progress",
      "name": "IsChapterDone",
      "sentence": "Chapter _PARAM1_ is done",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const game = runtimeScene.getGame();",
            "const chapters = game.getVariables().get('Content').getChild('chapters');",
            "const index = Math.round(eventsFunctionContext.getArgument(\"Index\"));",
            "if (index < 0 || index >= chapters.getChildrenCount()) { eventsFunctionContext.returnValue = false; return; }",
            "const id = chapters.getChildAt(index).getChild('id').getAsString();",
            "const done = game.getVariables().get('Save').getChild('done');",
            "eventsFunctionContext.returnValue = done.hasChild(id) && done.getChild(id).getAsBoolean();",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Chapter index",
          "name": "Index",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
