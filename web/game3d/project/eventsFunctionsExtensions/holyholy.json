    {
      "description": "Replaces the global variable with the content of a JSON resource (preloaded with the game).",
      "fullName": "Load a JSON resource into a global variable",
      "functionType": "Action",
      "group": "Data",
      "name": "LoadJsonIntoGlobal",
      "sentence": "Load _PARAM1_ into global variable _PARAM2_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const game = runtimeScene.getGame();",
            "const target = game.getVariables().get(eventsFunctionContext.getArgument(\"Variable\"));",
            "const resource = eventsFunctionContext.getArgument(\"Resource\");",
            "const manager = game.getJsonManager();",
            "const apply = content => { if (content) target.fromJSObject(content); };",
            "if (manager.isJsonLoaded(resource)) apply(manager.getLoadedJson(resource));",
            "else manager.loadJson(resource, (error, content) => { if (error) console.error('HolyHoly: cannot load', resource, error); else apply(content); });",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "JSON resource",
          "name": "Resource",
          "type": "jsonResource"
        },
        {
          "description": "Name of the global variable",
          "name": "Variable",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Checks that a global structure variable has children (e.g. the content finished loading).",
      "fullName": "Global variable has content",
      "functionType": "Condition",
      "group": "Data",
      "name": "IsGlobalLoaded",
      "sentence": "Global variable _PARAM1_ is loaded",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const v = runtimeScene.getGame().getVariables().get(eventsFunctionContext.getArgument(\"Variable\"));",
            "eventsFunctionContext.returnValue = v.getType() === 'structure' && Object.keys(v.getAllChildren()).length > 0;",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Name of the global variable",
          "name": "Variable",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Reads the save from the browser storage and merges it over the global variable (its current value holds the defaults). Unknown or broken data is ignored.",
      "fullName": "Load the save",
      "functionType": "Action",
      "group": "Save",
      "name": "LoadSave",
      "sentence": "Load the save _PARAM2_ into global variable _PARAM1_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const target = runtimeScene.getGame().getVariables().get(eventsFunctionContext.getArgument(\"Variable\"));",
            "let saved = null;",
            "try {",
            "  saved = JSON.parse(window.localStorage.getItem(eventsFunctionContext.getArgument(\"Key\")) || 'null');",
            "} catch (e) {",
            "  saved = null; // private mode or corrupted data: keep the defaults",
            "}",
            "const merge = (variable, data) => {",
            "  for (const key of Object.keys(data)) {",
            "    const value = data[key];",
            "    const child = variable.getChild(key);",
            "    if (value && typeof value === 'object' && !Array.isArray(value) && child.getType() === 'structure') merge(child, value);",
            "    else child.fromJSObject(value);",
            "  }",
            "};",
            "if (saved && typeof saved === 'object' && !Array.isArray(saved)) merge(target, saved);",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Name of the global variable",
          "name": "Variable",
          "type": "string"
        },
        {
          "description": "Storage key",
          "name": "Key",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "Writes the global variable to the browser storage (ignored when storage is unavailable).",
      "fullName": "Store the save",
      "functionType": "Action",
      "group": "Save",
      "name": "StoreSave",
      "sentence": "Store global variable _PARAM1_ as save _PARAM2_",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const source = runtimeScene.getGame().getVariables().get(eventsFunctionContext.getArgument(\"Variable\"));",
            "try {",
            "  window.localStorage.setItem(eventsFunctionContext.getArgument(\"Key\"), JSON.stringify(source.toJSObject()));",
            "} catch (e) {",
            "  // storage full or blocked: the game goes on, progress stays in memory",
            "}",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Name of the global variable",
          "name": "Variable",
          "type": "string"
        },
        {
          "description": "Storage key",
          "name": "Key",
          "type": "string"
        }
      ],
      "objectGroups": []
    },
    {
      "description": "X on the 2D layers of a position in the 3D world (base layer camera).",
      "fullName": "Screen X of a 3D position",
      "functionType": "Expression",
      "group": "3D",
      "name": "ScreenX",
      "sentence": "",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const camera = runtimeScene.getLayer('').getRenderer().getThreeCamera();",
            "if (!camera || typeof THREE === 'undefined') { eventsFunctionContext.returnValue = 0; return; }",
            "const v = new THREE.Vector3(eventsFunctionContext.getArgument(\"X\"), -eventsFunctionContext.getArgument(\"Y\"), eventsFunctionContext.getArgument(\"Z\"));",
            "camera.updateMatrixWorld();",
            "v.project(camera);",
            "eventsFunctionContext.returnValue = (v.x + 1) / 2 * runtimeScene.getGame().getGameResolutionWidth();",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "expressionType": {
        "type": "expression"
      },
      "parameters": [
