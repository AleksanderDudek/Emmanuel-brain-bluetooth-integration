    {
      "description": "One tick of the focus charger; call it every frame during play. Standing still for more than 0.12 s counts as focus (as in the 2D game).",
      "fullName": "Update focus",
      "functionType": "Action",
      "group": "Focus",
      "name": "Update",
      "sentence": "Update focus (delta _PARAM1_ s, standing still for _PARAM2_ s)",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const focus = window.MendiFocus;",
            "if (!focus) {  return; }",
            "focus.update(eventsFunctionContext.getArgument(\"Delta\"), eventsFunctionContext.getArgument(\"StillSeconds\") > 0.12);",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [
        {
          "description": "Seconds since the last frame",
          "name": "Delta",
          "type": "expression"
        },
        {
          "description": "How long the angel has stood still (s)",
          "name": "StillSeconds",
          "type": "expression"
        }
      ],
      "objectGroups": []
    },
