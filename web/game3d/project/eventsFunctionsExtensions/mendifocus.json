      "description": "Opens the browser's Bluetooth chooser (call it right after a click or tap).",
      "fullName": "Connect the band",
      "functionType": "Action",
      "group": "Band",
      "name": "Connect",
      "sentence": "Connect the Mendi band",
      "events": [
        {
          "type": "BuiltinCommonInstructions::JsCode",
          "inlineCode": [
            "const focus = window.MendiFocus;",
            "if (!focus) {  return; }",
            "focus.connect();",
            ""
          ],
          "parameterObjects": "",
          "useStrict": true,
          "eventsSheetExpanded": true
        }
      ],
      "parameters": [],
      "objectGroups": []
    },
