{
  "name": "brainlink-fnirs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BrainLink fNIRS (Mendi) as an installable, offline Progressive Web App: Web Bluetooth, live haemodynamics, balance trainer, sessions stored in the browser or a local folder.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:game": "vite --config vite.game.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.game.config.ts",
    "build:game": "vite build --config vite.game.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "python3 scripts/make_fixtures.py"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@types/web-bluetooth": "0.0.21",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vite-pwa/assets-generator": "1.0.4",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
