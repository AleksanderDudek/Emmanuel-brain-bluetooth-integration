{
  "name": "brainlink-fnirs-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BrainLink fNIRS (Mendi) as an installable, offline Progressive Web App: Web Bluetooth, live haemodynamics, balance trainer, sessions stored in the browser or a local folder.",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:game": "vite --config vite.game.config.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.game.config.ts && node game3d/tools/export.mjs",
    "build:game": "vite build --config vite.game.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "python3 scripts/make_fixtures.py",
    "dev:game3d": "node game3d/tools/export.mjs && vite preview --outDir dist/holyholyholy3d --port 5175 --strictPort",
    "game3d:export": "node game3d/tools/export.mjs",
    "game3d:check": "node game3d/tools/build-libs.mjs --check && node game3d/tools/build-content.mjs --check && node game3d/generator/build.mjs --check && node game3d/tools/export.mjs --check",
    "game3d:libs": "node game3d/tools/build-libs.mjs",
    "game3d:content": "node game3d/tools/build-content.mjs",
    "game3d:generate": "node game3d/generator/build.mjs --save",
    "game3d:art": "${ART_PYTHON:-python3} game3d/tools/art.py generate && ${ART_PYTHON:-python3} game3d/tools/art.py process",
    "game3d:billboards": "node game3d/tools/build-billboards.mjs",
    "game3d:assets": "node game3d/tools/build-models.mjs && node game3d/tools/build-textures.mjs && node game3d/tools/build-billboards.mjs",
    "game3d:fonts": "python3 game3d/tools/build-fonts.py",
    "game3d:smoke": "node game3d/tools/smoke.mjs",
    "app:smoke": "node scripts/app-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@types/web-bluetooth": "0.0.21",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vite-pwa/assets-generator": "1.0.4",
    "fake-indexeddb": "6.2.5",
    "gdcore-tools": "2.0.0-gd-v5.6.269-autobuild",
    "happy-dom": "20.14.5",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.11.0",
    "rolldown": "1.2.14",
    "three": "0.185.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  }
}
